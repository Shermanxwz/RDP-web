# Bare-binary defaults
RDPWEB_ADDR=:8080
RDPWEB_DATA_DIR=./data
RDPWEB_SESSION_TTL=720h

# Docker Compose host bind. Keep loopback when using a reverse proxy.
RDPWEB_BIND_IP=127.0.0.1

# Production HTTPS example:
# RDPWEB_PUBLIC_URL=https://rdp.example.com
# RDPWEB_SECURE_COOKIE=auto

# Optional deterministic first-run provisioning token.
# If omitted and no owner exists, RDP Web generates one and logs it once.
# RDPWEB_SETUP_TOKEN=replace-with-a-long-random-value
